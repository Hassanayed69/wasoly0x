# ── مطلوب في الإنتاج ───────────────────────────────────────────
APP_SECRET=               # نص عشوائي طويل — يُستخدم لتوقيع كوكي الجلسة
NODE_ENV=production

# ── قاعدة البيانات (مطلوب) ─────────────────────────────────────
DATABASE_URL=             # mysql://user:pass@host:3306/db

# ── Google Sign-In (اختياري لكن مفضّل) ──────────────────────────
# أنشئ OAuth 2.0 Client ID (Web application) في Google Cloud Console.
# Authorized redirect URI: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin Role (اختياري) ────────────────────────────────────────
OWNER_UNION_ID=           # Union ID للمستخدم الذي يصبح admin عند أول دخول

# ── Kimi (قديم — غير مستخدم) ────────────────────────────────────
# اتركها فارغة. واجهة تسجيل الدخول تستخدم Google فقط.
APP_ID=
KIMI_AUTH_URL=
KIMI_OPEN_URL=
VITE_APP_ID=
VITE_KIMI_AUTH_URL=
